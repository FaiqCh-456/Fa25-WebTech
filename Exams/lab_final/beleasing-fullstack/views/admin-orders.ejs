<!DOCTYPE html>
<html lang="en">
<head> <%- include('layouts/header') %> </head>
<body>
    <%- include('partials/navbar') %>
    
    <div class="container py-5" style="margin-top: 80px;">
        <h2>Admin Orders Dashboard</h2>
        <table class="table table-striped mt-4 align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Order ID</th>
                    <th>Customer</th>
                    <th>Total</th>
                    <th>Date</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                <% orders.forEach(order => { %>
                <tr>
                    <td><small class="text-muted"><%= order._id %></small></td>
                    <td>
                        <span class="fw-bold"><%= order.customerName %></span><br>
                        <small class="text-muted"><%= order.email %></small>
                    </td>
                    <td>$<%= order.totalAmount %></td>
                    <td><%= order.createdAt.toDateString() %></td>
                    <td>
                        <span class="badge bg-<%= order.status === 'Confirmed' ? 'success' : (order.status === 'Cancelled' ? 'danger' : 'warning') %>">
                            <%= order.status %>
                        </span>
                    </td>
                    <td>
                        <a href="/admin/orders/<%= order._id %>" class="btn btn-sm btn-info text-white me-1">View</a>

                        <form action="/admin/order/status" method="POST" class="d-inline">
                            <input type="hidden" name="orderId" value="<%= order._id %>">
                            <button type="submit" name="status" value="Confirmed" class="btn btn-sm btn-outline-success" title="Confirm">✔</button>
                            <button type="submit" name="status" value="Cancelled" class="btn btn-sm btn-outline-danger" title="Cancel">✖</button>
                        </form>
                    </td>
                </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
    <%- include('layouts/footer') %>
</body>
</html>
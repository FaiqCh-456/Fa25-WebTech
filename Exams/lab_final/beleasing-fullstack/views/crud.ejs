<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('layouts/header') %>
</head>
<body>
    <%- include('partials/navbar') %>

    <section class="container" style="margin-top: 100px;">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2>Admin Dashboard</h2>
            <a href="/logout" class="btn btn-danger">Log Out</a>
        </div>
        
        <div class="card p-4 mb-5 shadow-sm">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 id="formTitle">Add New Car</h4>
                <button type="button" class="btn btn-outline-secondary btn-sm" id="cancelEditBtn" style="display: none;" onclick="resetForm()">Cancel Edit</button>
            </div>

            <form id="carForm">
                <input type="hidden" id="carId">

                <div class="row g-3">
                    <div class="col-md-6">
                        <input type="text" id="name" class="form-control" placeholder="Car Name (e.g. BMW X5)" required>
                    </div>
                    <div class="col-md-6">
                        <select id="category" class="form-select" required>
                            <option value="" disabled selected>Select Category</option>
                            <option value="Sedan">Sedan</option>
                            <option value="Hatchback">Hatchback</option>
                            <option value="Combi">Combi</option>
                            <option value="SUV">SUV</option>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <div class="input-group">
                            <span class="input-group-text">$</span>
                            <input type="number" id="price" class="form-control" placeholder="Price" required>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <input type="text" id="image" class="form-control" placeholder="Image URL" required>
                    </div>

                    <div class="col-md-3">
                        <input type="number" id="year" class="form-control" placeholder="Year (e.g. 2024)">
                    </div>
                    <div class="col-md-3">
                        <select id="transmission" class="form-select">
                            <option value="Automatic">Automatic</option>
                            <option value="Manual">Manual</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <select id="fuelType" class="form-select">
                            <option value="Petrol">Petrol</option>
                            <option value="Diesel">Diesel</option>
                            <option value="Hybrid">Hybrid</option>
                            <option value="Electric">Electric</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <input type="number" id="seats" class="form-control" placeholder="Seats (e.g. 5)">
                    </div>
                    
                    <div class="col-12">
                        <textarea id="description" class="form-control" rows="3" placeholder="Description of the car..." required></textarea>
                    </div>

                    <div class="col-12">
                        <button type="submit" class="btn btn-dark w-100" id="submitBtn">Add Car</button>
                    </div>
                </div>
            </form>
        </div>

        <div class="d-flex justify-content-between align-items-center mb-3">
            <h4>Manage Inventory</h4>
            <button class="btn btn-outline-secondary btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#filterPanel">
                Toggle Filters
            </button>
        </div>

        <div class="collapse show mb-4" id="filterPanel">
            <div class="card card-body bg-light border-0">
                <div class="row g-3">
                    <div class="col-md-4">
                        <input type="text" id="searchName" class="form-control" placeholder="Search by Name...">
                    </div>
                    <div class="col-md-4">
                        <select id="filterCategory" class="form-select">
                            <option value="">All Categories</option>
                            <option value="Sedan">Sedan</option>
                            <option value="Hatchback">Hatchback</option>
                            <option value="Combi">Combi</option>
                            <option value="SUV">SUV</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <input type="number" id="filterPrice" class="form-control" placeholder="Max Price ($)">
                    </div>
                </div>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle" id="inventoryTable">
                <thead class="table-light">
                    <tr>
                        <th>Name</th>
                        <th>Category</th>
                        <th>Price</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% if(cars.length > 0) { %>
                        <% cars.forEach(car => { %>
                        <tr class="car-row">
                            <td class="fw-bold car-name"><%= car.name %></td>
                            <td><span class="badge bg-secondary car-category"><%= car.category %></span></td>
                            <td class="car-price" data-price="<%= car.price %>">$<%= car.price %></td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-outline-primary me-2" 
                                    onclick="editCar('<%= car._id %>', '<%= car.name %>', '<%= car.category %>', '<%= car.price %>', '<%= car.image %>', `<%= car.description %>`, '<%= car.year %>', '<%= car.transmission %>', '<%= car.fuelType %>', '<%= car.seats %>')">
                                    Edit
                                </button>
                                <button onclick="deleteCar('<%= car._id %>')" class="btn btn-sm btn-outline-danger">Delete</button>
                            </td>
                        </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="4" class="text-center text-muted py-4">No cars in inventory. Add one above!</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
            <div id="noResults" class="text-center text-muted py-4" style="display: none;">
                No cars match your filters.
            </div>
        </div>
    </section>

    <script>
  
        document.addEventListener('DOMContentLoaded', function() {
            const searchName = document.getElementById('searchName');
            const filterCategory = document.getElementById('filterCategory');
            const filterPrice = document.getElementById('filterPrice');
            const rows = document.querySelectorAll('.car-row');
            const noResultsMsg = document.getElementById('noResults');

            function filterTable() {
                const nameVal = searchName.value.toLowerCase();
                const catVal = filterCategory.value.toLowerCase();
                const maxPrice = parseFloat(filterPrice.value);
                let visibleCount = 0;

                rows.forEach(row => {
                    const name = row.querySelector('.car-name').textContent.toLowerCase();
                    const category = row.querySelector('.car-category').textContent.toLowerCase();
                    const price = parseFloat(row.querySelector('.car-price').getAttribute('data-price'));

                    let isVisible = true;

                    // Filter Logic
                    if (nameVal && !name.includes(nameVal)) isVisible = false;
                    if (catVal && category !== catVal) isVisible = false;
                    if (!isNaN(maxPrice) && price > maxPrice) isVisible = false;

                    // Toggle Visibility
                    row.style.display = isVisible ? '' : 'none';
                    if(isVisible) visibleCount++;
                });

                // Show 'No Results' if everything is hidden
                noResultsMsg.style.display = visibleCount === 0 ? 'block' : 'none';
            }

            // Listen for changes
            searchName.addEventListener('input', filterTable);
            filterCategory.addEventListener('change', filterTable);
            filterPrice.addEventListener('input', filterTable);
        });

        const carForm = document.getElementById('carForm');
        
        carForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            const id = document.getElementById('carId').value;
            
            const data = {
                name: document.getElementById('name').value,
                category: document.getElementById('category').value,
                price: document.getElementById('price').value,
                image: document.getElementById('image').value,
                description: document.getElementById('description').value,
                year: document.getElementById('year').value || 2024,
                transmission: document.getElementById('transmission').value || 'Automatic',
                fuelType: document.getElementById('fuelType').value || 'Petrol',
                seats: document.getElementById('seats').value || 5
            };

            const url = id ? '/api/cars/' + id : '/api/cars';
            const method = id ? 'PUT' : 'POST';

            const res = await fetch(url, {
                method: method,
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            });
            
            if (res.ok) window.location.reload();
            else alert("Error saving");
        });

     
        function editCar(id, name, category, price, image, description, year, transmission, fuelType, seats) {
            document.getElementById('carId').value = id;
            document.getElementById('name').value = name;
            document.getElementById('category').value = category;
            document.getElementById('price').value = price;
            document.getElementById('image').value = image;
            document.getElementById('description').value = description;
            
            document.getElementById('year').value = year;
            document.getElementById('transmission').value = transmission;
            document.getElementById('fuelType').value = fuelType;
            document.getElementById('seats').value = seats;

            document.getElementById('formTitle').innerText = "Edit Car";
            document.getElementById('submitBtn').innerText = "Update Car";
            document.getElementById('submitBtn').classList.remove('btn-dark');
            document.getElementById('submitBtn').classList.add('btn-primary');
            document.getElementById('cancelEditBtn').style.display = 'block';
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function resetForm() {
            carForm.reset();
            document.getElementById('carId').value = '';
            document.getElementById('formTitle').innerText = "Add New Car";
            document.getElementById('submitBtn').innerText = "Add Car";
            document.getElementById('submitBtn').classList.remove('btn-primary');
            document.getElementById('submitBtn').classList.add('btn-dark');
            document.getElementById('cancelEditBtn').style.display = 'none';
        }

      
        async function deleteCar(id) {
            if(confirm('Are you sure?')) {
                const response = await fetch('/api/cars/' + id, { method: 'DELETE' });
                if (response.ok) window.location.reload();
            }
        }
    </script>
    <%- include('layouts/footer') %>
</body>
</html>
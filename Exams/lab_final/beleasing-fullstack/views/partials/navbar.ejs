<header>
    <nav class="navbar navbar-expand-lg bg-white p-0 shadow-sm fixed-top">
        <div class="container-fluid p-0 h-100">
            
            <a class="navbar-brand logo-container d-flex align-items-center justify-content-center px-4 h-100" href="/">
                <span class="logo-text text-white"><strong>be</strong>leasing</span>
                <span class="logo-icon ms-1 text-warning">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" class="bi bi-cursor-fill" viewBox="0 0 16 16">
                        <path d="M14.082 2.182a.5.5 0 0 1 .103.557L8.528 15.467a.5.5 0 0 1-.917-.007L5.57 10.694.803 8.652a.5.5 0 0 1-.006-.916l12.728-5.657a.5.5 0 0 1 .556.103z"/>
                    </svg>
                </span>
            </a>

            <div class="brand-tagline ms-4 d-none d-md-block">
                LUXURY CARS FOR YOU
            </div>

            <button class="navbar-toggler me-3" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse justify-content-end bg-white" id="navbarNav">
                <ul class="navbar-nav align-items-center gap-4 pe-5 py-3 py-lg-0">
                    <li class="nav-item">
                        <a class="nav-link custom-link" href="/">HOME</a>
                    </li>
                    <li class="nav-item dropdown">
                        <a class="nav-link custom-link dropdown-toggle" href="/offer" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            OFFER
                        </a>
                        <ul class="dropdown-menu border-0 shadow-sm rounded-0">
                            <li><a class="dropdown-item small text-uppercase" href="/offer">View All Cars</a></li>
                            <li><a class="dropdown-item small text-uppercase" href="/offer?category=SUV">SUVs</a></li>
                            <li><a class="dropdown-item small text-uppercase" href="/offer?category=Sedan">Sedans</a></li>
                            <li><a class="dropdown-item small text-uppercase" href="/offer?category=Hatchback">Hatchback</a></li>
                            <li><a class="dropdown-item small text-uppercase" href="/offer?category=Combi">Combi</a></li>
                        </ul>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link custom-link" href="/about">ABOUT</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link custom-link" href="/contact">CONTACT</a>
                    </li>

                    <li class="nav-item">
                        <a href="/checkout" class="nav-link custom-link position-relative">
                            CART
                            <% if(locals.cart && locals.cart.length > 0) { %>
                                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size: 0.6rem;">
                                    <%= locals.cart.reduce((sum, item) => sum + item.quantity, 0) %>
                                </span>
                            <% } %>
                        </a>
                    </li>

                    <% if (user) { %>
                        <% if (user.isAdmin) { %>
                            <li class="nav-item ms-lg-2">
                                <a class="btn btn-sm btn-dark rounded-0 px-3 text-uppercase fw-bold" href="/crud">Admin</a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-sm btn-outline-secondary rounded-0 px-3 text-uppercase fw-bold" href="/admin/orders">Orders</a>
                            </li>
                        <% } %>
                        <li class="nav-item ms-lg-2">
                            <a class="nav-link custom-link text-danger" href="/logout">LOGOUT</a>
                        </li>
                    <% } else { %>
                        <li class="nav-item ms-lg-2">
                            <a class="nav-link custom-link" href="/login">LOGIN</a>
                        </li>
                    <% } %>
                </ul>
            </div>
        </div>
    </nav>
</header>
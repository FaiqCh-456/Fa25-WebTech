<!DOCTYPE html>
<html lang="en">
<head> <%- include('layouts/header') %> </head>
<body>
    <%- include('partials/navbar') %>

    <div class="container py-5" style="margin-top: 80px;">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2>Order Details</h2>
            <a href="/admin/orders" class="btn btn-outline-secondary">&larr; Back to Dashboard</a>
        </div>

        <div class="row">
            <div class="col-md-4 mb-4">
                <div class="card shadow-sm">
                    <div class="card-header bg-dark text-white">
                        Customer Information
                    </div>
                    <div class="card-body">
                        <p><strong>Order ID:</strong> <br> <small class="text-muted"><%= order._id %></small></p>
                        <p><strong>Name:</strong> <br> <%= order.customerName %></p>
                        <p><strong>Email:</strong> <br> <a href="mailto:<%= order.email %>"><%= order.email %></a></p>
                        <p><strong>Phone:</strong> <br> <%= order.phone %></p>
                        <p><strong>Address:</strong> <br> <%= order.address %></p>
                        <p><strong>Date Placed:</strong> <br> <%= order.createdAt.toLocaleString() %></p>
                        <p><strong>Current Status:</strong> <br> 
                            <span class="badge bg-<%= order.status === 'Confirmed' ? 'success' : (order.status === 'Cancelled' ? 'danger' : 'warning') %>">
                                <%= order.status %>
                            </span>
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-md-8">
                <div class="card shadow-sm">
                    <div class="card-header bg-white">
                        <h5 class="mb-0">Purchased Items</h5>
                    </div>
                    <div class="table-responsive">
                        <table class="table mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Product</th>
                                    <th>Unit Price</th>
                                    <th>Qty</th>
                                    <th class="text-end">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% order.items.forEach(item => { %>
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <% if(item.product && item.product.image) { %>
                                                    <img src="<%= item.product.image %>" alt="car" style="width: 50px; height: 35px; object-fit: cover; border-radius: 4px; margin-right: 10px;">
                                                <% } %>
                                                <div>
                                                    <span class="fw-bold"><%= item.product ? item.product.name : 'Deleted Product' %></span>
                                                </div>
                                            </div>
                                        </td>
                                        <td>$<%= item.price %></td>
                                        <td>x<%= item.quantity %></td>
                                        <td class="text-end">$<%= item.price * item.quantity %></td>
                                    </tr>
                                <% }) %>
                            </tbody>
                            <tfoot class="table-light">
                                <tr>
                                    <td colspan="3" class="text-end fw-bold">Grand Total:</td>
                                    <td class="text-end fw-bold fs-5">$<%= order.totalAmount %></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>

                <div class="card mt-4 shadow-sm border-0 bg-light">
                    <div class="card-body d-flex align-items-center justify-content-between">
                        <span>Update Order Status:</span>
                        <form action="/admin/order/status" method="POST" class="d-flex gap-2">
                            <input type="hidden" name="orderId" value="<%= order._id %>">
                            <button type="submit" name="status" value="Confirmed" class="btn btn-success">Confirm Order</button>
                            <button type="submit" name="status" value="Cancelled" class="btn btn-danger">Cancel Order</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <%- include('layouts/footer') %>
</body>
</html>